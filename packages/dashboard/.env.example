# Override the daemon URL the dashboard talks to.
# Default: window.location.origin (so the daemon can serve the dashboard
# itself in production and the same host carries both REST and WS).
# VITE_API_URL=http://127.0.0.1:3000

# Use the daemon's /mock/* fixtures for project-scoped GETs (workflow,
# events, projects, runtime availability). Requires the daemon to be
# started with LOOMFLO_MOCK_API=1.
# VITE_USE_MOCK=1
